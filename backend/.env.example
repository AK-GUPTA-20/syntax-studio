# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Admin Security
ADMIN_SECRET_KEY=your_admin_secret_key_min_32_chars
ADMIN_ACCESS_TOKEN=your_admin_login_password
# Optional: Dedicated JWT signing secret (defaults to ADMIN_SECRET_KEY if omitted)
# JWT_SECRET=your_dedicated_jwt_secret_min_32_chars
# Optional: Pre-hashed bcrypt password for zero plaintext password storage
# ADMIN_PASSWORD_HASH=$2b$12$...
# Optional: Webhook signature verification secret
# WEBHOOK_SECRET=your_webhook_signing_secret

# ImageKit Configuration
IMAGEKIT_PUBLIC_KEY=****************
IMAGEKIT_PRIVATE_KEY=************************
IMAGEKIT_URL_ENDPOINT=***********************

# Firebase Configuration (Optional: provide to connect directly to Cloud Firestore)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Or provide the path to service account json:
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Promo Code & Discount Configuration
PROMO_CODE=syntaxStudio
DISCOUNT_PERCENT=10

# Resend Email Verification Configuration
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Support Studio <noreply@support-studio.work.gd>
BACKEND_URL=http://localhost:5000
